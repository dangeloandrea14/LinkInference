{
    "data": {
        "class": "erasure.data.datasets.DatasetManager.DatasetManager",
        "parameters": {
            "DataSource": {
                "class": "erasure.data.data_sources.TorchGeometricDataSource.TorchGeometricDataSource",
                "parameters": {
                    "datasource": {
                        "class": "torch_geometric.datasets.Amazon",
                        "parameters": {
                            "root": "resources/data",
                            "name": "Photo"
                        },
                        "preprocess": []
                    }
                }
            },
            "partitions": [
                {
                    "class": "erasure.data.datasets.DataSplitterGraph.DataSplitterPercentage",
                    "parameters": {
                        "parts_names": [
                            "all_shuffled",
                            "-"
                        ],
                        "percentage": 1,
                        "shuffle": true
                    }
                },
                {
                    "class": "erasure.data.datasets.DataSplitterGraph.DataSplitterPercentage",
                    "parameters": {
                        "parts_names": [
                            "train_0",
                            "test"
                        ],
                        "percentage": 0.8,
                        "ref_data": "all_shuffled",
                        "shuffle": false
                    }
                },
                {
                    "class": "erasure.data.datasets.DataSplitterGraph.DataSplitterPercentage",
                    "parameters": {
                        "parts_names": [
                            "validation",
                            "train"
                        ],
                        "percentage": 0.1,
                        "ref_data": "train_0",
                        "shuffle": false
                    }
                },
                {
                    "class": "erasure.data.datasets.DataSplitterGraph.DataSplitterEdgeHoldout",
                    "parameters": {
                        "parts_names": [
                            "lp_test_pos",
                            "lp_val_pos",
                            "lp_train_pos"
                        ],
                        "test_percentage": 0.1,
                        "val_percentage": 0.05,
                        "ref_data": "all"
                    }
                },
                {
                    "class": "erasure.data.datasets.DataSplitterGraph.DataSplitterEdgeDifficulty",
                    "parameters": {
                        "parts_names": [
                            "forget",
                            "retain"
                        ],
                        "percentage": 0.05,
                        "ref_data": "all",
                        "mode": "easy",
                        "exclude_parts": [
                            "lp_test_pos",
                            "lp_val_pos"
                        ]
                    }
                }
            ],
            "batch_size": 4,
            "split_seed": 16
        }
    },
    "predictor": {
        "class": "erasure.model.TorchGraphLinkModel.TorchGraphLinkModel",
        "parameters": {
            "alias": "AmazonPhotos_GCN_LP_easy",
            "epochs": 200,
            "optimizer": {
                "class": "torch.optim.Adam",
                "parameters": {
                    "lr": 0.005
                }
            },
            "loss_fn": {
                "class": "torch.nn.BCEWithLogitsLoss",
                "parameters": {}
            },
            "model": {
                "class": "erasure.model.graphs.LinkPredictor.LinkPredictor",
                "parameters": {
                    "encoder": {
                        "class": "erasure.model.graphs.GCN.GCN",
                        "parameters": {
                            "in_channels": 745,
                            "hidden_channels": [
                                64
                            ],
                            "out_channels": 64
                        }
                    },
                    "decoder": "mlp"
                }
            },
            "device": "cpu"
        }
    },
    "unlearners": [
        {
            "compose_idt": "configs/snippets/u_id.json"
        },
        {
            "class": "erasure.unlearners.GoldModel.GoldModelGraph",
            "parameters": {
                "training_set": "retain"
            }
        },
        {
            "class": "erasure.unlearners.graph_unlearners.Finetuning.Finetuning",
            "parameters": {
                "epochs": 1,
                "ref_data": "retain",
                "optimizer": {
                    "class": "torch.optim.Adam",
                    "parameters": {
                        "lr": 0.001
                    }
                }
            }
        },
        {
            "class": "erasure.unlearners.graph_unlearners.NegGrad.NegGrad",
            "parameters": {
                "epochs": 1,
                "ref_data": "forget",
                "optimizer": {
                    "class": "torch.optim.Adam",
                    "parameters": {
                        "lr": 0.001
                    }
                }
            }
        },
        {
            "class": "erasure.unlearners.graph_unlearners.AdvancedNegGrad.AdvancedNegGrad",
            "parameters": {
                "epochs": 1,
                "ref_data_retain": "retain",
                "ref_data_forget": "forget",
                "optimizer": {
                    "class": "torch.optim.Adam",
                    "parameters": {
                        "lr": 0.001
                    }
                }
            }
        },
        {
            "class": "erasure.unlearners.graph_unlearners.GNNDelete.GNNDelete",
            "parameters": {
                "epochs": 10,
                "lr": 0.001,
                "alpha": 0.5,
                "loss_fct": "mse_mean",
                "ref_data_forget": "forget"
            }
        }
    ],
    "evaluator": {
        "class": "erasure.evaluations.manager.Evaluator",
        "parameters": {
            "measures": [
                {
                    "class": "erasure.evaluations.running.RunTime"
                },
                {
                    "class": "erasure.evaluations.measures.LinkPredictionGraph",
                    "parameters": {
                        "partition": "lp_test_pos",
                        "target": "unlearned"
                    }
                },
                {
                    "class": "erasure.evaluations.measures.LinkPredictionGraph",
                    "parameters": {
                        "partition": "lp_test_pos",
                        "target": "original"
                    }
                },
                {
                    "class": "erasure.evaluations.measures.LinkPredictionGraph",
                    "parameters": {
                        "partition": "forget",
                        "target": "unlearned"
                    }
                },
                {
                    "class": "erasure.evaluations.measures.LinkPredictionGraph",
                    "parameters": {
                        "partition": "forget",
                        "target": "original"
                    }
                },
                {
                    "class": "erasure.evaluations.LinkTeller.LinkTeller.LinkTeller",
                    "parameters": {
                        "target": "unlearn"
                    }
                },
                {
                    "class": "erasure.evaluations.link_stealing_attack.link_stealing_attack_0.LinkStealing0",
                    "parameters": {
                        "target": "unlearned",
                        "apply_softmax": false
                    }
                },
                {
                    "class": "erasure.evaluations.measures.SaveValues",
                    "parameters": {
                        "path": "output/rebuttal/linkpred/runs/AmazonPhotos_GCN_easy.json"
                    }
                }
            ]
        }
    },
    "globals": {
        "cached": "true",
        "seed": 0,
        "removal_type": "edge"
    }
}